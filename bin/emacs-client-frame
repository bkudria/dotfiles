#!/bin/sh
# $EDITOR-compatible emacsclient wrapper:
# - Raises existing Emacs frame (macOS 15.3+ compatible)
# - Opens file in existing frame (no new frame)
# - Blocks until C-x # (correct for $EDITOR)
# - Starts daemon if no server running

osascript -e 'tell application "System Events" to tell application process "Emacs" to set frontmost to true' 2>/dev/null
exec emacsclient -q --alternate-editor "" "$@"
