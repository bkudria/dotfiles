# ignore all non-hidden files
/*

# allow hidden files
!.*

# allow specific non-hidden directories
!bin/
!Library/
!icloud/

/Library/**

# Hammerspoon - ignore compiled output and deps
/.hammerspoon/Spoons/
/.hammerspoon/pasteboard_history.json
/.hammerspoon/.clips.sqlite
/.hammerspoon/*.lua
!/.hammerspoon/init.lua
/.hammerspoon/*.js
/.hammerspoon/node_modules/
/.hammerspoon/package.json
/.hammerspoon/package-lock.json
/.hammerspoon/tmp/
/.hammerspoon/*.bak

# Claude Code - track settings and skills only
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/statusline-p10k.zsh
!/.claude/skills/

# .config - track only specific tool configs
/.config/*
!/.config/btop/
!/.config/ccstatusline/
!/.config/chrome/
/.config/chrome/Cached*
!/.config/direnv/
!/.config/gemsmith/
!/.config/iterm2/
!/.config/karabiner.edn

/.doom.d/snippets/fundamental-mode/untracked/*
/.doom.d/custom.el

# History/state files
.*history

# Compiled zsh files
*.zwc

# Zim build artifacts
/.zim/.latest_version
/.zim/init.zsh.old
/.zim/init.zsh
/.zim/modules/
!/.zim/modules/bkudria/

.aider*
!.aider.commands
!.aider.conf.yml
!.aider.context.md
!.aider.env

*/*.elc
*/*.git
*/*.hg

/.CFUserTextEncoding
/.DS_Store
/.ICEauthority
/.aptible
/.aws
/.bundle
/.bundler
/.cache
/.cocoapods
/.docker
/.eclim
/.emacs.d/auto-save-list
/.emacs.d/elpa
/.fontconfig
/.fonts
/.gconf
/.gem
/.gitconfigs
/.hgext
/.icons
/.ipython
/.java
/.local
/.neocomplete
/.pex
/.ptpython
/.pulse
/.pyenv
/.pylint.d
/.rbenv
/.rvm
/.ssh
/.subversion
/.thumbnails
/.vim/bundle
/.vim/undo
/.virtualenvs
/.wallpapers
/.wine


.Trash
.cargo
.cpan
.envrc
.evolution
.fasd
.iterm2_shell_integration.zsh
.ivy2
.keychain
.lesshst
.mozilla
.netrc
.node-gyp
.npm
.npmrc
.ollama
.pants.rc
.pgcli*
.platformio
.saws.log
.semantic-highlight-cache
.vagrant.d
.venv
.vim/.netrwhist
.vim/eclim
.viminfo

.zcompcache
.zcompdump*
.zsh-histfile

**/.claude/settings.local.json
