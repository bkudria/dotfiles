# Sets sane Zsh built-in environment options.
zmodule environment

# Provides handy git aliases and functions.
zmodule git -c "zstyle ':zim:git' aliases-prefix 'g'"
zmodule git

# Applies correct bindkeys for input events.
zmodule input

# Sets a custom terminal title.
zmodule termtitle -c "zstyle ':zim:termtitle' hooks 'preexec' 'precmd'"
zmodule termtitle -c "zstyle ':zim:termtitle:preexec' format '\${\${(A)=1}[1]}'"
zmodule termtitle -c "zstyle ':zim:termtitle:precmd' format '%1~'"
zmodule termtitle


# Utility aliases and functions. Adds colour to ls, grep and less.
zmodule utility

# Exposes to prompts how long the last command took to execute.
zmodule duration-info -c "zstyle ':zim:duration-info' show-milliseconds yes"
zmodule duration-info

# Exposes git repository status information to prompts.
zmodule git-info

# p10k
zmodule romkatv/powerlevel10k

# Figures out where to get the best help, and gets it.
zmodule run-help

# Provides archive and unarchive functions for easy archive manipulation.
zmodule archive

# Sets up the direnv Zsh shell integration
zmodule direnv

# Adds aliases and better defaults for exa.
zmodule exa

# Configures fzf for faster fetching of files and directories names.
zmodule fzf

# Shown when there is no command and user presses ENTER.
zmodule magic-enter

# Manages all python venvs in one place.
zmodule pvenv

# Provides ruby, bundler, rbenv and rvm aliases and initialization.
zmodule ruby

# Provides a convenient way to load ssh-agent.
zmodule ssh

# Formats the current working directory to be used by prompts.
zmodule prompt-pwd

# Adds aliases for Homebrew.
zmodule homebrew

# Sets up github-cli in zsh.
zmodule joke/zim-github-cli

# Sets up yq in zsh.
zmodule joke/zim-yq

# Sets up zoxide in zsh.
zmodule kiesman99/zim-zoxide


zmodule sorin-ionescu/prezto --root modules/command-not-found

zmodule belak/prezto-contrib --root alias-tips



# Custom module
zmodule ${ZDOTDIR:-${HOME}}/.zim/modules/bkudria





# Additional completion definitions for Zsh.
zmodule zsh-users/zsh-completions --fpath src

# Enables and configures smart and extensive tab completion.
# completion must be sourced after all modules that add completion definitions.
zmodule completion

#
# Modules that must be initialized last
#

# Fish-like syntax highlighting for Zsh.
# zsh-users/zsh-syntax-highlighting must be sourced after completion
zmodule zsh-users/zsh-syntax-highlighting

# Fish-like history search (up arrow) for Zsh.
# zsh-users/zsh-history-substring-search must be sourced after zsh-users/zsh-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search

# Fish-like autosuggestions for Zsh.
zmodule zsh-users/zsh-autosuggestions
