{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Write(~/.claude/skills/*/evals/**)",
      "Edit(~/.claude/skills/*/evals/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(grep:*)",
      "Bash(printf:*)",
      "Bash(tput:*)",
      "Bash(sw_vers:*)",
      "Bash(eslint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git log:*)",
      "Bash(git revert:*)",
      "Bash(git worktree:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(git ls-remote:*)",
      "Bash(git clone:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "WebFetch(domain:docs.anthropic.com)",
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)"
    ],
    "ask": [
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl rollout undo:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl attach:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl cordon:*)",
      "Bash(kubectl uncordon:*)",
      "Bash(kubectl taint:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl set:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Bash(aws ec2 delete-:*)",
      "Bash(aws ec2 modify-:*)",
      "Bash(aws ec2 stop-instances:*)",
      "Bash(aws ec2 reboot-instances:*)",
      "Bash(aws rds delete-:*)",
      "Bash(aws rds modify-:*)",
      "Bash(aws rds stop-:*)",
      "Bash(aws ecs delete-:*)",
      "Bash(aws ecs update-service:*)",
      "Bash(aws eks delete-:*)",
      "Bash(aws iam create-:*)",
      "Bash(aws iam delete-:*)",
      "Bash(aws iam attach-:*)",
      "Bash(aws iam detach-:*)",
      "Bash(aws iam put-:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3api delete-:*)",
      "Bash(aws s3api put-:*)",
      "Bash(aws lambda delete-:*)",
      "Bash(aws secretsmanager delete-:*)",
      "Bash(aws secretsmanager put-:*)",
      "Bash(aws route53 change-:*)",
      "Bash(aws logs delete-:*)",
      "Bash(aws dynamodb delete-:*)",
      "Bash(aws dynamodb update-:*)",
      "Bash(aws dynamodb put-:*)",
      "Bash(aws dynamodb batch-write-:*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/ccstatusline/scripts/dispatch.sh",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "triage@bkudria-cc-plugins": true,
    "allium@juxt-plugins": true,
    "datadog@chime-claude-plugins": true,
    "editing-confluence-pages@chime-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "bkudria-cc-plugins": {
      "source": {
        "source": "directory",
        "path": "/opt/me/code/cc-plugins"
      }
    },
    "juxt-plugins": {
      "source": {
        "source": "github",
        "repo": "juxt/claude-plugins"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "preferredNotifChannel": "iterm2_with_bell",
  "terminalProgressBarEnabled": false,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "alwaysThinkingEnabled": true,
  "verbose": true
}
