[user]
	name = Benjamin Kudria
	email = ben@kudria.net
[github]
	user = bkudria
[core]
	editor = vim
	pager = delta
	whitespace = trailing-space,space-before-tab,cr-at-eol
	excludesfile = /opt/me/.gitignore_global
[push]
	default = simple
	all = true
	pruneTags = true
	autoSetupRemote = true
	followTags = true

[clean]
	requireForce = false
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	ui = auto
	pager = false
[diff]
	mnemonicprefix = true
	algorithm = minimal
	compactionHeuristic = true
	colorMoved = plain
	renames = true
[log]
	date = relative
[alias]
	discard = checkout HEAD --
	ls = ls-files
	top = !eval cd "$(pwd)/$(git rev-parse --show-cdup)" && pwd
	pr = pull-request
	code-changes = "!git log --format=format: --name-only | egrep -v '^$' | sort | uniq -c | sort -rg | head -10"
	cc = "!git code-changes"
[help]
	autocorrect = prompt
[git-up "bundler"]
	check = true
[include]
	path = ~/.gitconfigs/chime.gitconfig
[magit]
	hideCampaign = true
[magithub]
	online = false
[magithub "status"]
	includeStatusHeader = false
	includePullRequestsSection = false
	includeIssuesSection = false
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
	templatedir = /Users/bkudria/.git_template
[gpg]
	program = /usr/local/MacGPG2/bin/gpg2
[pull]
	rebase = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[privacy]
	pattern = s
	limit = 08-24
[column]
	ui  = auto
[branch]
	sort=-committerdate
[tag]
	sort=version:refname
[init]

[commit]
	verbose = true
[rerere]
	enabled = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[merge]
	conflictStyle = zdiff3
[fetch]
	prune = true
	pruneTags = true
	all = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
