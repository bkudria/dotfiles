class Screens
  asus1 = "7AD41316-E066-4DC9-85A5-8BB89406EC5F"
  oledUUIDs = {[asus1]: asus1}
  hs.window.filter.forceRefreshOnSpaceChange = false

  new: =>
    print("screens init")
    @screenWatcher = hs.screen.watcher.new( -> @screensChanged!)
    @windowFilter = hs.window.filter.new!
    @shades = {}
    @shadesDebouncer = hs.timer.delayed.new(60*10, -> @maybeShade!)
    @windowEventDebouncer = hs.timer.delayed.new(0.2, -> @handleWindowEvent!)


  start: =>
    print("component start")
    @shades = hs.fnutils.imap(@oledScreensRects!, (oledScreenRect) ->
      shade = hs.drawing.rectangle(oledScreenRect)
      with shade
        \setFillColor({white: 0, alpha: 1})
        \setStroke(false)
        \setFill(true)
        \setBehavior(17)
      shade
    )
    print("made shades")

    @screenWatcher\start!

    print "sw"

    @windowFilter\subscribe(
      hs.window.filter.windowFocused, -> @windowEventDebouncer\start!
    )
    @windowFilter\subscribe(
      hs.window.filter.windowUnfocused, -> @windowEventDebouncer\start!
    )
    @windowFilter\subscribe(
      hs.window.filter.windowMoved, -> @windowEventDebouncer\start!
    )

    print "wf"

    @shadesDebouncer\start!

    print "sd"

    -- restore shaded state on restart
    @drawShades! if hs.settings.get("shaded")

  oledScreens: => [hs.screen.find(uuid) for i, uuid in pairs oledUUIDs]
  oledScreensRects: => hs.fnutils.imap(@oledScreens!, (screen) -> screen\fullFrame!)

  handleWindowEvent: =>
    -- print hs.inspect oledUUIDs
    -- print hs.inspect hs.window.focusedWindow!
    -- print hs.inspect hs.window.focusedWindow!\screen!
    -- print hs.inspect hs.window.focusedWindow!\screen!\getUUID!
    print("focus event")
    focusedScreenUUID = hs.window.focusedWindow!\screen!\getUUID!
    if oledUUIDs[focusedScreenUUID]
      print("oled focused event")
      @unshade!
      @shadesDebouncer\start!

  maybeShade: =>
    print "maybeShade"
    focusedScreenUUID = hs.window.focusedWindow!\screen!\getUUID!
    if oledUUIDs[focusedScreenUUID]
      print("oled focused")
      @shadesDebouncer\start!
    else
      @drawShades!

  unshade: =>
    print("unshade")
    hs.fnutils.imap(@shades, (shade) -> shade\hide!)
    hs.settings.set("shaded", false)

  drawShades: =>
    print("drawShades")
    return if hs.settings.get("shaded")
    return if hs.settings.get("mode") == "media"

    print("shading")
    hs.fnutils.ieach(@shades, (shade) ->
      with shade
        \bringToFront(true)
        \show(10)
    )
    hs.settings.set("shaded", true)

  screensChanged: =>
    print("screensChanged")
    @unshade!
    @start!
