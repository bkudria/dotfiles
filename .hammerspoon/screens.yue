class Screens extends Drive
  icon: "🖥️"

  onNew: =>
    @saveScreens!
    @screenWatcher = hs.screen.watcher.new( -> @screensChanged!)

  onStart: =>
    @screenWatcher::start!

  screensChanged: =>
    @saveScreens!

  saveScreens: =>
    positions = hs.fnutils.sortByKeyValues hs.screen.screenPositions!, (first, second) -> first.x < second.x

    screens = [ screen::getUUID! for screen, _ in positions]
    hs.settings.set("screens", screens)

    @dell1, @dell2, @asus3 = table.unpack screens

  oledUUIDs: => {[@asus3]: true}

  oledScreens: =>
    [hs.screen.find(uuid) for uuid, _ in pairs @oledUUIDs!]

  oledScreensRects: =>
    hs.fnutils.imap(@oledScreens!, (screen) -> screen::fullFrame!)
