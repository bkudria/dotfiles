class Screens extends Drive
  asus1 = "7AD41316-E066-4DC9-85A5-8BB89406EC5F"
  oledUUIDs = {[asus1]: asus1}
  hs.window.filter.forceRefreshOnSpaceChange = false

  icon: "🖥️"
  delay: 30

  onNew: =>
    @screenWatcher = hs.screen.watcher.new( -> @screensChanged!)
    @windowFilter = hs.window.filter.new!
    @shades = {}
    @windowEventDebouncer = hs.timer.delayed.new(0.2, -> @handleWindowEvent!)
    @shadesDebouncer = hs.timer.delayed.new(@delay, -> @maybeShade!)

  scheduleNext: => @shadesDebouncer::start!

  onStart: =>
    return unless #@oledScreens! > 0
    @shades = hs.fnutils.imap(@oledScreensRects!, (oledScreenRect) ->
      shade = hs.drawing.rectangle(oledScreenRect)
      with shade
        ::setFillColor({white: 0, alpha: 1})
        ::setStroke(false)
        ::setFill(true)
        ::setBehavior(17)
      shade
    )

    @screenWatcher::start!

    @windowFilter::subscribe(
      hs.window.filter.windowFocused, -> @scheduleNext!
    )
    @windowFilter::subscribe(
      hs.window.filter.windowUnfocused, -> @scheduleNext!
    )
    @windowFilter::subscribe(
      hs.window.filter.windowMoved, -> @scheduleNext!
    )

    @scheduleNext!

    -- restore shaded state on restart
    @logger.i "we were shaded" if hs.settings.get("shaded")
    @drawShades(0) if hs.settings.get("shaded")

    t = os.time() + @delay
    @logger.i "Scheduled next shade for #{os.date("%I:%M:%S %p",t)}"

    @saveScreens!

  oledScreens: => [hs.screen.find(uuid) for i, uuid in pairs oledUUIDs]
  oledScreensRects: => hs.fnutils.imap(@oledScreens!, (screen) -> screen::fullFrame!)

  handleWindowEvent: =>
    window = hs.window.focusedWindow!
    return unless window

    focusedScreenUUID = window::screen!::getUUID!
    if oledUUIDs[focusedScreenUUID]
      print("oled focused event")
      @unshade!
      @scheduleNext!

  maybeShade: =>
    focusedScreenUUID = hs.window.focusedWindow!::screen!::getUUID!
    if oledUUIDs[focusedScreenUUID]
      @scheduleNext!
    else
      @drawShades! unless hs.settings.get("shaded")

  unshade: =>
    hs.fnutils.imap(@shades, (shade) -> shade::hide!)
    hs.settings.set("shaded", false)

  drawShades: (duration = 10) =>
    return if hs.settings.get("mode") == "media"

    t = os.time() + @delay
    @logger.i "Scheduled next shade for #{os.date("%I:%M:%S %p",t)}"

    hs.fnutils.ieach(@shades, (shade) ->
      with shade
        ::bringToFront(true)
        ::show(duration)
    )
    hs.settings.set("shaded", true)

  saveScreens: =>
    positions = hs.fnutils.sortByKeyValues hs.screen.screenPositions!, (first, second) -> first.x < second.x

    screens = [ screen::getUUID! for screen, _ in positions]
    hs.settings.set("screens", screens)

  screensChanged: =>
    @saveScreens!
    @unshade!
    @restart!
