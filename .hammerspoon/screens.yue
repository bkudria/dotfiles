class Screens extends Drive
  icon: "🖥️"

  onNew: =>
    @screenWatcher = hs.screen.watcher.new( -> @screensChanged!)

    @setScreensBrightness = hs.timer.delayed.new(0.5, -> @setScreensBrightnessNow!)
    @setScreensContrast = hs.timer.delayed.new(0.5, -> @setScreensContrastNow!)

  onStart: =>
    @initialState = @getInfo!
    @screenWatcher::start!

    @setScreensBrightness::start!
    @setScreensContrast::start!

  getInfo: =>
    positions = hs.screen.screenPositions!

    uuidsByIDFn = hs.fnutils.sortByKeys positions, (first, second) -> first::id! < second::id!
    uuidsByUUIDFn = hs.fnutils.sortByKeyValues positions, (first, second) -> first.x < second.x

    uuidsByID = [ screen::getUUID! for screen, _ in uuidsByIDFn ]
    uuidsByPosition = [ screen::getUUID! for screen, _ in uuidsByUUIDFn ]
    numScreens = #uuidsByID

    command = "/usr/local/bin/lunar displays -j | /opt/homebrew/bin/jq 'map({brightness,contrast})'"
    @displaysInfo = hs.json.decode((hs.execute(command)))

    brightnesses = [info.brightness for info in *@displaysInfo]
    contrasts = [info.contrast for info in *@displaysInfo]

    brightness = hs.fnutils.reduce(brightnesses, (a,b) -> a+b) // numScreens
    contrast = hs.fnutils.reduce(contrasts, (a,b) -> a+b) // numScreens

    {:brightness, :contrast, :numScreens, :uuidsByPosition, :uuidsByID}

  screensChanged: => @mergeIntoState @getInfo!

  onStateChanged: (key) =>
    @setScreensBrightness::start! if key == "brightness"
    @setScreensContrast::start! if key == "contrast"

  setScreensBrightnessNow: => @lunarPropSet("brightness", @state.brightness)
  setScreensContrastNow:  => @lunarPropSet("contrast", @state.contrast)

  lunarPropSet: (prop, value) =>
    @lunarTask(["displays", "all", prop, "#{value}"])

  lunarTask: (args) =>
    hs.task.new("/usr/local/bin/lunar",  f, args)::start!
