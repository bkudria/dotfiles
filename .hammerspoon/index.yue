--
-- Early Init
--
global p = (...) -> print hs.inspect ...
global timeDeltaFrom = (time) -> string.format("%.3f", (hs.timer.absoluteTime! - time) / 1000000) .. "ms"

epochTime = hs.timer.absoluteTime!

global reloads = hs.watchable.new("reloads", true)

global Drive = require "drive"

console = require("console")!::start!

timeLogger = hs.logger.new("→", "info")

timed = (lbl, fn) ->
  print ""
  timeLogger.i "#{lbl}"
  startTime = hs.timer.absoluteTime!
  result = fn!
  timeLogger.i("⏰ #{timeDeltaFrom startTime} to #{lbl}")
  result

--
-- Early Start
--
timed "start early modules", ->
  global *
  watcher = require("watcher")!::start!
  clock = require("clock")!::start!
  flux = require("flux")!::start!

  require("settings")!::start!

--
-- Load & Init
--
timed "load & init modules", ->
  global *

  dispatch = require("dispatch")!::dispatch
  extensions = require("extensions")!

  deck = require("deck")!

  appAndApps = require 'apps' -- TODO rewrite
  App = appAndApps[1]
  apps = appAndApps[2]

  thrust = require("thrust")! -- TODO implement
  actions = require("actions")(thrust) -- TODO clean up

  -- Matte = require 'matte' -- TODO delete?
  -- matte = Matte!::wrap(apps.Chrome) -- TODO delete

  yasnippets = require 'yasnippets' -- TODO defer filescan
  selectedText = require 'selected_text' --TODO replace with BTT functionality?

  --  gates = require("gates")! -- TODO implement

  -- matte = Matte!::wrap(apps.Chrome) -- TODO delete?

  typer = require("typer")(yasnippets(apps.Emacs)) -- TODO lazy load, clean up typer

  clipper = require("clipper")!

  paster = require("paster")(clipper, typer)

  screens = require("screens")! -- TODO extend to replace hazeover


  Hyper = require("hyper")

  dispatch = require("dispatch")!::dispatch

--
-- Config & Start
--
timed "configure hyperspace", ->
  Hyper!::space{
    '`': -> clock::show!
    'tab': typer::autocomplete_word
    '1': -> clock::showDate!
    '2': -> hs.shortcuts.run "OCR -> Clipboard"
    "\"": nil -- A11y
    'left': -> App.current!::left!
    'right': -> App.current!::right!
    'up': -> App.current!::up!
    'down': -> App.current!::down!
    ']': nil -- Siri
    ';': -> hs.eventtap.keyStroke( {'cmd', 'ctrl'} , 'space' )
    '[': -> hs.eventtap.keyStroke( {'cmd', 'shift'} , '/' )
    '-': nil -- Notification Center
    'b': apps.Chrome
    'c': apps.NotionCalendar
    'd': nil -- Dash
    'e': apps.Emacs
    'g': Hyper(name: 'Selected Text', afterAction: (hyper) -> hyper.modal::exit!)::space{
      'u': -> hs.eventtap.keyStrokes(string.upper(selectedText!))
      'l': Hyper(name: 'Link', afterAction: (hyper) -> hyper.modal::exit!)::space{
        'b': -> hs.eventtap.keyStrokes("[#{selectedText!}](#{apps.Chrome.currentURL!})")
        -- 't': -> matte::chooseTab((tab) ->
        --   hs.eventtap.keyStrokes("[#{selectedText!}](#{tab["url"]})") if tab
        -- )
        'v': -> hs.eventtap.keyStrokes("[#{selectedText!}](#{hs.pasteboard.getContents!})")
      }
    }
    'i': Hyper(name: "Insert", afterAction: (hyper) -> hyper.modal::exit!)::space{
      'b': Hyper(name: 'Browser Tab', afterAction: (hyper) -> hyper.modal::exit!)::space{
        'b': -> hs.eventtap.keyStrokes(apps.Chrome.currentURL!)
        -- 'l': -> matte::chooseTab((tab) -> hs.eventtap.keyStrokes("[#{tab['title']}](#{tab['url']})") if tab)
        -- 'u': -> matte::chooseTab((tab) -> hs.eventtap.keyStrokes(tab['url']) if tab)
        -- 't': -> matte::chooseTab((tab) -> hs.eventtap.keyStrokes(tab['title']) if tab)
      }
    }
    'k': apps.Slack
    'l': apps.Island
    'n': apps.Notion
    'r': apps.Reeder
    's': Hyper(name: 'System', afterAction: (hyper) -> hyper.modal::exit!)::space{
      'delete': hs.caffeinate.systemSleep
      'down': -> screens::maybeShade!
      'c': hs.toggleConsole
      'h': actions::hybridMode
      'l': hs.caffeinate.startScreensaver
      'r': -> watcher::reload!
      's': actions::normalMode
      'w': actions::mediaMode
      'f': actions::toggleMovieMode
      ',': actions::editConfig
      'escape': (hyper) -> hyper.modal::exit!
    }
    't': apps.iTerm
    'v': ->
        paster::select!
    'w': Hyper(name: 'Window', afterAction: (hyper) -> hyper.modal::exit!)::space{
      'left': -> actions::moveToScreenLeft!
      'right': -> actions::moveToScreenRight!
      '1': -> actions::moveToScreen(nil, hs.settings.get("screens")[1])
      '2': -> actions::moveToScreen(nil, hs.settings.get("screens")[2])
      '3': -> actions::moveToScreen(nil, hs.settings.get("screens")[3])
      'space': -> actions::moveToScreen(nil, hs.settings.get("screens")[2])
      'w': -> actions::maximize!
      'h': -> actions::moveToScreenLeft!
      'j': -> actions::screenFraction(2, 2)
      'k': -> actions::screenFraction(1, 2)
      'l': -> actions::moveToScreenRight!
      'm': -> actions::maximize!
      'z': -> hs.window.focusedWindow!::toggleZoom!
      '`': -> hs.hints.windowHints(hs.window.filter.default::getWindows!)
      'escape': (hyper) -> hyper.modal::exit!
    }
    'z': apps.Zoom
  }

timed "start spoons", ->
  extensions::start{
      Seal: {
        start: true,
        hotkeys: {toggle: {{'cmd'}, 'SPACE'}},
        fn: (seal) ->
          seal.show = (self, query) ->
            frame = hs.mouse.getCurrentScreen!::frame!
            center = frame.center
            self.chooser::query('')
            self.chooser::show(center::move({frame.w * -0.2, frame.h * -0.2}))
            self

          seal::loadPlugins{'apps', 'useractions', 'calc'}
          seal.plugins.useractions.actions = {Sleep: {fn: -> hs.caffeinate.systemSleep!}}
          seal.plugins.apps.appSearchPaths = {
            "/Applications", "/System/Applications",
            "/System/Library/PreferencePanes", "~/Applications"
          }
          seal.plugins.apps::restart!
      },
      -- PaperWM: {
      --   url: "https://github.com/mogenson/PaperWM.spoon",
      --   desc: "PaperWM.spoon repository",
      --   branch: "release",
      --   repo: "PaperWM",
      --   config: { screen_margin: 16, window_gap: 64 },
      --   start: true,
      --   hotkeys: {}
      -- }
    }

timed "configure siri remote", ->
  global *
  rButton = (message) -> dispatch message, {
    tapup:    App.current!::rUp
    tapdown:  App.current!::rDown
    tapleft:  App.current!::rLeft
    tapright: App.current!::rRight

    back: App.current!::rBack
    screen: App.current!::rScreen

    playpause: App.current!::rPlayPause
    mute: App.current!::rMute

    plus: App.current!::rPlus
    minus: App.current!::rMinus

    microphone: App.current!::toggleAudio
    power: App.current!::toggleVideo
  }

timed "start remaining modules", ->
  screens::start!
  typer::start!
  clipper::start!
  thrust::start!
  -- matte::start!
  -- gates::start!

timed "install URL handler", ->
  hs.urlevent.httpCallback = (scheme, host, params, fullURL, senderPID) -> apps.Chrome.openBackgroundURL(fullURL)
  hs.urlevent.setDefaultHandler("http")

timeLogger.i("⏰ #{timeDeltaFrom epochTime} total")

export.rButton = rButton

