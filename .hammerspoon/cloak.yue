-- TODO independent per-screen cloaking (or just seperate instances?)
oledUUIDs = {
  -- ["7F74CC60-846F-4E98-B479-4F0E94374D94"]: true
  ["7AD41316-E066-4DC9-85A5-8BB89406EC5F"]: true
}

class Cloak extends Drive
  icon: "⬛️"
  delay: 5*60

  onNew:  =>
    hs.window.filter.forceRefreshOnSpaceChange = false

    @watchState "Screens.numScreens", -> @resetCloaks!

    @windowFilter = hs.window.filter.new!
    @cloaks = {}
    @windowEventDebouncer = hs.timer.delayed.new(0.01, -> @uncloak! if @shouldBeUncloaked!)
    @cloaksDebouncer = hs.timer.delayed.new(@delay, -> @maybeCloak!)

    @persistedStateKeys = { "cloaked" }

  onStart: =>
    -- TODO combine
    -- TODO does BTT trigger?
    @windowFilter::subscribe(
      [ hs.window.filter.windowFocused,
        hs.window.filter.windowUnfocused,
        hs.window.filter.windowMoved ],
      -> @windowEventDebouncer::start!,
      true
    )

    @resetCloaks!

  resetCloaks: =>
    return unless #@oledScreens! > 0

    hs.fnutils.imap @cloaks, (cloak) -> cloak::delete(0.1)

    @cloaks = hs.fnutils.imap(@oledScreensRects!, (oledScreenRect) ->
      cloak = hs.canvas.new(oledScreenRect)
        ::appendElements { type: "rectangle", action: "fill", fillColor: {white: 0} }
        ::behavior(17)
      cloak
    )

    if @state.cloaked
        @drawCloaks(0) -- restore cloaked state on restart
    else
        @scheduleNext! -- otherwise just schedule

  shouldBeUncloaked: =>
    screens = [hs.window.focusedWindow!?::screen!, hs.mouse.getCurrentScreen!]
    uuids = [screen?::getUUID! for screen in *screens]
    hs.settings.get("mode") == "media" or hs.fnutils.some(uuids, (uuid) -> oledUUIDs[uuid])

  oledScreens: =>
    [hs.screen.find(uuid) for uuid, _ in pairs oledUUIDs]

  oledScreensRects: =>
    hs.fnutils.imap(@oledScreens!, (screen) -> screen::fullFrame!)

  scheduleNext: =>
    @cloaksDebouncer::start!
    t = os.time() + @delay
    @logger.d "Scheduled next cloak for #{os.date("%I:%M:%S %p",t)}"

  maybeCloak: =>
    if @shouldBeUncloaked!
      @scheduleNext!
    else
      @drawCloaks! unless @state.cloaked

  uncloak: =>
    hs.fnutils.imap(@cloaks, (cloak) -> cloak::hide(0.5))
    @state.cloaked = false
    @scheduleNext!

  drawCloaks: (duration = 5) =>
    hs.fnutils.ieach(@cloaks, (cloak) ->
      with cloak
        ::bringToFront(true)
        ::show(duration)
    )
    @state.cloaked = true
    @scheduleNext!
