oledUUIDs = {["7AD41316-E066-4DC9-85A5-8BB89406EC5F"]: true}

class Cloak extends Drive
  icon: "⬛️"
  delay: 5*60

  onNew: (@screens) =>
    hs.window.filter.forceRefreshOnSpaceChange = false

    @screensSettingWatcher = hs.settings.watchKey("cloak", "screens", ->
      @logger.i("screens changed")
      @screensChanged!
    )

    @windowFilter = hs.window.filter.new!
    @shades = {}
    @windowEventDebouncer = hs.timer.delayed.new(0.1, -> @unshade! if @shouldBeUnshaded!)
    @shadesDebouncer = hs.timer.delayed.new(@delay, -> @maybeShade!)

    @persistedStateKeys = { "cloaked" }

  onStart: =>
    return unless #@oledScreens! > 0

    @shades = hs.fnutils.imap(@oledScreensRects!, (oledScreenRect) ->
      shade = hs.drawing.rectangle(oledScreenRect)
      with shade
        ::setFillColor({white: 0, alpha: 1})
        ::setStroke(false)
        ::setFill(true)
        ::setBehavior(17)
      shade
    )

    -- TODO combine
    -- TODO does BTT trigger?
    @windowFilter::subscribe(
      hs.window.filter.windowFocused, -> @windowEventDebouncer::start!
    )
    @windowFilter::subscribe(
      hs.window.filter.windowUnfocused, -> @windowEventDebouncer::start!
    )
    @windowFilter::subscribe(
      hs.window.filter.windowMoved, -> @windowEventDebouncer::start!
    )

    if @state.cloaked
        @drawShades(0) -- restore shaded state on restart
    else
        @scheduleNext! -- otherwise just schedule

  screensChanged: =>
    @unshade!
    @restart!

  shouldBeUnshaded: =>
    screens = [hs.window.focusedWindow!?::screen!, hs.mouse.getCurrentScreen!]
    uuids = [screen?::getUUID! for screen in *screens]
    hs.settings.get("mode") == "media" or hs.fnutils.some(uuids, (uuid) -> oledUUIDs[uuid])

  oledScreens: =>
    [hs.screen.find(uuid) for uuid, _ in pairs oledUUIDs]

  oledScreensRects: =>
    hs.fnutils.imap(@oledScreens!, (screen) -> screen::fullFrame!)


  scheduleNext: =>
    @shadesDebouncer::start!
    t = os.time() + @delay
    @logger.d "Scheduled next shade for #{os.date("%I:%M:%S %p",t)}"

  maybeShade: =>
    if @shouldBeUnshaded!
      @scheduleNext!
    else
      @drawShades! unless @state.cloaked

  unshade: =>
    hs.fnutils.imap(@shades, (shade) -> shade::hide!)
    @state.cloaked = false
    @scheduleNext!

  drawShades: (duration = 10) =>
    hs.fnutils.ieach(@shades, (shade) ->
      with shade
        ::bringToFront(true)
        ::show(duration)
    )
    @state.cloaked = true
    @scheduleNext!
