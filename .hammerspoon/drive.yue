import 'yue'

timeDeltaFrom = (time) -> string.format("%.3f", (hs.timer.absoluteTime! - time) / 1000000) .. "ms"

-- TODO macros for caught error logging?
-- name `...` so we can move custom behavior into `try` blocks
-- figure out how else to compact / DRY
-- pull out inflections?
class Drive
  --
  -- Logging
  --
  logger: => @logger
  getName: (...) => @@__name

  -- State
  onStateChanged: (...) => -- Placeholder
  mergeIntoState: (...) => for k,v in pairs ... do @state[k] =  v
  watchState: (path, key, callback) =>
    pathKey = if type(key) == "string" then path.."."..key else path

    return pathKey if @watchers[pathKey] or @watchers[path..".*"]

    @watchers[pathKey] = hs.watchable.watch(path, key, callback)

    pathKey

  getState: (path, key) =>
    pathKey = if type(key) == "string" then path.."."..key else path

    if watcher := @watchers[pathKey] then return watcher::value!
    elseif watcher := @watchers[path..".*"] then return watcher::value(key)
    else
      watcher = hs.watchable.watch(path, key)
      value = watcher::value!
      watcher = nil
      return value


  --
  -- Lifecycle
  --

  -- Placeholders
  beforeNew: (...) =>
  beforeStart: (...) =>
  beforeStop: (...) =>

  onNew: (...) =>
  onStart: (...)  =>
  onStop: (...) =>

  afterNew: (...) =>
  afterStart: (...) =>
  afterStop: (...) =>

  --
  -- new
  --
  new: (...) =>
    time = hs.timer.absoluteTime!

    -- Logging
    @logger = hs.logger.new "#{@icon or @name}", "info"
    @name = @getName(...)

    -- State
    @persistedStateKeys = [] -- TODO allow declerative
    @initialState = hs.settings.get(@@__name)
    initialState = { initializedAt: os.time! }
    @initialState = do
      if @initialState == nil
        initialState
      else
        @initialState

    @state = hs.watchable.new(@name, true)
    @watchers = []

    for k,v in pairs @initialState do @state[k] = v

    @initialized = false
    @started = false

    try
      @logger.d "beforeNew!"
      @beforeNew(...)
    catch err
      @logger.e "🔴 Error before initializing #{@@__name}:"
      @logger.e "  #{yue.traceback err}"
      hs.openConsole(true)

    try
      @logger.d "onNew!"
      result = @onNew(...)
      @initialized = true
    catch err
      @logger.e "🔴 Error initializing #{@@__name}:"
      @logger.e "  #{yue.traceback err}"
      hs.openConsole(true)

    try
      @logger.d "afterNew!"
      @afterNew(...)
    catch err
      @logger.w "🔴 Error after initializing #{@@__name}:"
      @logger.w "  #{yue.traceback err}"
      hs.openConsole(true)

    @logger.i("⏱️ #{timeDeltaFrom time} to 🔵 init #{@name}")
    @initialized

  --
  -- start
  --
  start: (...) =>
    return @logger.e "🔴 Not starting #{@@__name}, initialization failed" unless @initialized
    return @logger.e "🔴 Not starting #{@@__name}, it's already started!" if @started

    time = hs.timer.absoluteTime!

    try
      @logger.d "beforeStart!"
      @beforeStart(...)
    catch err
      @logger.e "🔴 Error before starting #{@@__name}:"
      @logger.e "  #{err}"
      hs.openConsole(true)

    try
      @logger.d "start!"
      result = @onStart(...)
      @started = true
    catch err
      @logger.e "🔴 Error starting #{@@__name}:"
      @logger.e "  #{err}"
      hs.openConsole(true)

    for k,v in pairs @initialState
      @state[k] = @state[k] or v

    try
      @logger.d "afterStart!"
      @afterStart(...)
    catch err
      @logger.w "🔴 Error after starting #{@@__name}:"
      @logger.w "  #{err}"
      hs.openConsole(true)

    @watchState "Loader.reloading", -> @stop!
    @watchState "#{@name}.*", (watcher, path, key, old, new) ->
      try
        @onStateChanged(key, old, new)
      catch err
        @logger.w "🔴 Error handling #{key} state change:"
        @logger.w "  #{yue.traceback err}"
        hs.openConsole(true)

    @logger.i("⏱️ #{timeDeltaFrom time} to 🟢️ start #{@name}")
    return (result or self) if @started
    return false

  --
  -- stop
  --
  stop: (...) =>
    args = {...}
    return @logger.e "🔴 Not stopping #{@@__name}, initialization failed" unless @initialized
    return @logger.e "🔴 Not stopping #{@@__name}, it's not started!" unless @started

    time = hs.timer.absoluteTime!

    try
      @logger.d "beforeStop!"
      @beforeStop(table.unpack args)
    catch err
      @logger.e "🔴 Error before stopping #{@@__name}:"
      @logger.e "  #{err}"
      hs.openConsole(true)

    try
      @logger.d "stop!"
      result = @onStop(table.unpack args)

    catch err
      @logger.e "🔴 Error stopping #{@@__name}:"
      @logger.e "  #{err}"
      hs.openConsole(true)

    @started = false
    persistedKeys = [...@persistedStateKeys, "initializedAt", "persistedAt", "modifiedAt"]
    settings = { key, value for key, value in pairs @state when key in persistedKeys}

    settings.persistedAt = os.time!
    hs.settings.set(@@__name, settings)

    try
      @logger.d "afterStop!"
      @afterStop(table.unpack args)

      @watchers = nil
      @watchers = []
    catch err
      @logger.w "🔴 Error after stopping #{@@__name}:"
      @logger.w "  #{err}"
      hs.openConsole(true)

    @logger.i("⏱️ #{timeDeltaFrom time} to ⚫️ stop #{@@__name}")
    return (result or self) unless @started
    return false

  restart: =>
    @stop! if @started
    @start!
