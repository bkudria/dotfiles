import 'yue'

class Drive
  logger: => @logger

  beforeNew: (...) =>
  onNew: (...) =>
  afterNew: (...) =>
  getName: (...) => @@__name

  new: (...) =>
    time = hs.timer.absoluteTime!
    @name = @getName(...)

    @logger = hs.logger.new "#{@icon or @name}", "info"

    @persistedStateKeys = [] -- TODO allow declerative
    @initialState = hs.settings.get(@@__name)

    initialState = { initializedAt: os.time! }
    @initialState = do
      if @initialState == nil
        initialState
      else
        @initialState

    @state = hs.watchable.new(@name, true)

    for k,v in pairs @initialState
      @state[k] = v

    @reloadWatcher = nil
    @initialized = false
    @started = false

    -- @logger.i "#{collectgarbage("count") kB}"
    try
      @logger.d "beforeNew!"
      @beforeNew(...)
    catch err
      @logger.e "🔴 Error before initializing #{@@__name}:"
      @logger.e "  #{yue.traceback err}"
      hs.openConsole(true)

    try
      @logger.d "onNew!"
      result = @onNew(...)
      @initialized = true
    catch err
      @logger.e "🔴 Error initializing #{@@__name}:"
      @logger.e "  #{yue.traceback err}"
      hs.openConsole(true)

    try
      @logger.d "afterNew!"
      @afterNew(...)
    catch err
      @logger.w "🔴 Error after initializing #{@@__name}:"
      @logger.w "  #{yue.traceback err}"
      hs.openConsole(true)

    @logger.i("⏱️ #{timeDeltaFrom time} to 🔵 init #{@name}")
    @initialized

  beforeStart: (...) =>
  onStart: (...)  =>
  afterStart: (...) =>
  onStateChanged: (...) =>

  start: (...) =>
    return @logger.e "🔴 Not starting #{@@__name}, initialization failed" unless @initialized
    return @logger.e "🔴 Not starting #{@@__name}, it's already started!" if @started

    time = hs.timer.absoluteTime!
    try
      @logger.d "beforeStart!"
      @beforeStart(...)
    catch err
      @logger.e "🔴 Error before starting #{@@__name}:"
      @logger.e "  #{err}"
      hs.openConsole(true)

    try
      @logger.d "start!"
      result = @onStart(...)
      @started = true
    catch err
      @logger.e "🔴 Error starting #{@@__name}:"
      @logger.e "  #{err}"
      hs.openConsole(true)

    for k,v in pairs @initialState
      @state[k] = @state[k] or v

    try
      @logger.d "afterStart!"
      @afterStart(...)
    catch err
      @logger.w "🔴 Error after starting #{@@__name}:"
      @logger.w "  #{err}"
      hs.openConsole(true)

    @stateWatcher = hs.watchable.watch(@@__name, "*", (watcher, path, key, old, new) ->
      try
        @onStateChanged(key, old, new)
      catch err
        @logger.w "🔴 Error handling #{key} state change:"
        @logger.w "  #{yue.traceback err}"
        hs.openConsole(true)
    )

    @reloadWatcher = hs.watchable.watch("Loader", "reloading", -> @stop!)
    @logger.i("⏱️ #{timeDeltaFrom time} to 🟢️ start #{@name}")
    return (result or self) if @started
    return false

  mergeIntoState: (...) =>
    for k,v in pairs ...
      @state[k] =  v

  beforeStop: (...) =>
  onStop: (...) =>
  afterStop: (...) =>

  stop: (...) =>
    return @logger.e "🔴 Not stopping #{@@__name}, initialization failed" unless @initialized
    return @logger.e "🔴 Not stopping #{@@__name}, it's not started!" unless @started

    time = hs.timer.absoluteTime!
    try
      @logger.d "beforeStop!"
      @beforeStop(...)
    catch err
      @logger.e "🔴 Error before stopping #{@@__name}:"
      @logger.e "  #{err}"
      hs.openConsole(true)

    try
      @logger.d "stop!"
      result = @onStop(...)
      @started = false
    catch err
      @logger.e "🔴 Error stopping #{@@__name}:"
      @logger.e "  #{err}"
      hs.openConsole(true)

    persistedKeys = [...@persistedStateKeys, "initializedAt", "persistedAt", "modifiedAt"]
    settings = { key, value for key, value in pairs @state when key in persistedKeys}
    settings.persistedAt = os.time!
    hs.settings.set(@@__name, settings)

    try
      @logger.d "afterStop!"
      @afterStop(...)
    catch err
      @logger.w "🔴 Error after stopping #{@@__name}:"
      @logger.w "  #{err}"
      hs.openConsole(true)

    @logger.i("⏱️ #{timeDeltaFrom time} to ⚫️ stop #{@@__name}")
    return (result or self) unless @started
    return false

  restart: =>
    @stop! if @started
    @start!
