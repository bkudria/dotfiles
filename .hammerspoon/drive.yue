import 'yue'

class Drive
  @go: =>
    instance = @@!
    instance::start!
    instance

  icon: => @icon
  logger: => @logger

  beforeNew: (...) =>
  onNew: (...) =>
  afterNew: (...) =>

  new: (...) =>
    @initialized = false
    @started = false
    @logger = hs.logger.new "#{@@__name}", "info"

    time = hs.timer.absoluteTime!
    try
      @logger.d "beforeNew!"
      @beforeNew(...)
    catch err
      @logger.e "🔴 Error before initializing driver:"
      @logger.e "  #{yue.traceback err}"

    try
      @logger.d "onNew!"
      result = @onNew(...)
      @initialized = true
    catch err
      @logger.e "🔴 Error initializing drive:"
      @logger.e "  #{yue.traceback err}"

    try
      @logger.d "afterNew!"
      @afterNew(...)
    catch err
      @logger.w "🔴 Error after initializing drive:"
      @logger.w "  #{yue.traceback err}"

    @logger.i("🔵 new in   ⏱️ #{(hs.timer.absoluteTime! - time) / 1000000}ms")
    @initialized

  beforeStart: (...) =>
  onStart: (...)  =>
  afterStart: (...) =>

  start: (...) =>
    return @logger.e "🔴 Not starting #{@@__name}, initialization failed" unless @initialized
    return @logger.e "🔴 Not starting #{@@__name}, it's already started!" if @started

    time = hs.timer.absoluteTime!
    try
      @logger.d "beforeStart!"
      @beforeStart(...)
    catch err
      @logger.e "🔴 Error before starting drive:"
      @logger.e "  #{err}"

    try
      @logger.d "start!"
      result = @onStart(...)
      @started = true
    catch err
      @logger.e "🔴 Error starting drive:"
      @logger.e "  #{err}"

    try
      @logger.d "afterStart!"
      @afterStart(...)
    catch err
      @logger.w "🔴 Error after starting drive:"
      @logger.w "  #{err}"

    @logger.i("🟢️ start in ⏱️ #{(hs.timer.absoluteTime! - time) / 1000000}ms")
    return result if @started
    return false

  beforeStop: (...) =>
  onStop: (...) =>
  afterStop: (...) =>

  stop: (...) =>
    return @logger.e "🔴 Not stopping, initialization failed" unless @initialized
    return @logger.e "🔴 Not stopping, it's not started!" unless @started

    time = hs.timer.absoluteTime!
    try
      @logger.d "beforeStop!"
      @beforeStop(...)
    catch err
      @logger.e "🔴 Error before stopping drive:"
      @logger.e "  #{err}"

    try
      @logger.d "stop!"
      result = @onStop(...)
      @started = false
    catch err
      @logger.e "🔴 Error stopping drive:"
      @logger.e "  #{err}"

    try
      @logger.d "afterStop!"
      @afterStop(...)
    catch err
      @logger.w "🔴 Error after stopping drive:"
      @logger.w "  #{err}"

    @logger.i("🔴 stop in ⏱️ #{(hs.timer.absoluteTime! - time) / 1000000}ms")
    return @result unless @started
    return false

  restart: =>
    @stop! if @started
    @start!
