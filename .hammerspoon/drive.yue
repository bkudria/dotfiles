import 'yue'

class Drive
  logger: => @logger

  beforeNew: (...) =>
  onNew: (...) =>
  afterNew: (...) =>
  name: (...) => @@__name

  new: (...) =>
    @logger = hs.logger.new "#{@icon or @name(...)}", "info"
    @state = hs.watchable.new(@name(...), true)

    @reloadWatcher = nil
    @initialized = false
    @started = false

    time = hs.timer.absoluteTime!
    try
      @logger.d "beforeNew!"
      @beforeNew(...)
    catch err
      @logger.e "🔴 Error before initializing #{@@__name}:"
      @logger.e "  #{yue.traceback err}"

    try
      @logger.d "onNew!"
      result = @onNew(...)
      @initialized = true
    catch err
      @logger.e "🔴 Error initializing #{@@__name}:"
      @logger.e "  #{yue.traceback err}"

    try
      @logger.d "afterNew!"
      @afterNew(...)
    catch err
      @logger.w "🔴 Error after initializing #{@@__name}:"
      @logger.w "  #{yue.traceback err}"

    @logger.i("⏱️ #{timeDeltaFrom time} to 🔵 init #{@name ...}")
    @initialized

  beforeStart: (...) =>
  onStart: (...)  =>
  afterStart: (...) =>

  start: (...) =>
    return @logger.e "🔴 Not starting #{@@__name}, initialization failed" unless @initialized
    return @logger.e "🔴 Not starting #{@@__name}, it's already started!" if @started

    time = hs.timer.absoluteTime!
    try
      @logger.d "beforeStart!"
      @beforeStart(...)
    catch err
      @logger.e "🔴 Error before starting #{@@__name}:"
      @logger.e "  #{err}"

    try
      @logger.d "start!"
      result = @onStart(...)
      @started = true
    catch err
      @logger.e "🔴 Error starting #{@@__name}:"
      @logger.e "  #{err}"

    try
      @logger.d "afterStart!"
      @afterStart(...)
    catch err
      @logger.w "🔴 Error after starting #{@@__name}:"
      @logger.w "  #{err}"

    @reloadWatcher = hs.watchable.watch("drive", "loader", -> @stop!)
    @logger.i("⏱️ #{timeDeltaFrom time} to 🟢️ start #{@name!}")
    return (result or self) if @started
    return false

  beforeStop: (...) =>
  onStop: (...) =>
  afterStop: (...) =>

  stop: (...) =>
    return @logger.e "🔴 Not stopping #{@@__name}, initialization failed" unless @initialized
    return @logger.e "🔴 Not stopping #{@@__name}, it's not started!" unless @started

    time = hs.timer.absoluteTime!
    try
      @logger.d "beforeStop!"
      @beforeStop(...)
    catch err
      @logger.e "🔴 Error before stopping #{@@__name}:"
      @logger.e "  #{err}"

    try
      @logger.d "stop!"
      result = @onStop(...)
      @started = false
    catch err
      @logger.e "🔴 Error stopping #{@@__name}:"
      @logger.e "  #{err}"

    try
      @logger.d "afterStop!"
      @afterStop(...)
    catch err
      @logger.w "🔴 Error after stopping #{@@__name}:"
      @logger.w "  #{err}"

    @logger.i("⏱️ #{timeDeltaFrom time} to 🔴 stop #{@@__name}")
    return (result or self) unless @started
    return false

  restart: =>
    @stop! if @started
    @start!
