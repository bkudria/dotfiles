clamp = (value, min, max) -> math.max(min, math.min(max, value))
clamp0100 = (value) -> clamp(value, 0, 100)

class Deck extends Drive
  icon: "🎛️"
  onNew: =>
    @screenBrightnessState = hs.watchable.watch("Screens", "brightness", (...) -> )
    @screenContrastState = hs.watchable.watch("Screens", "contrast", (...) -> )

    @initialState = { brightness: 50 }
    @persistedStateKeys = { "brightness" }

    @deck = nil
    @encoderState = [false, false, false, false]


  onStart: =>
    hs.streamdeck.init (connected, deck) -> @onInit(connected, deck)

  onInit: (connected, deck) =>
    if connected
      @logger.i "Connected to #{deck}"
      @deck = deck
      @deck::setBrightness @state.brightness
      @deck::encoderCallback (...) -> @onEncoder ...
    else
      @logger.i "Disconnected from #{@deck}"
      @deck = nil
      @stop!

  onEncoder: (deck, id, wasPressed, turnedLeft, turnedRight) =>
    return unless deck == @deck

    encoderStateKey = if @encoderState[id] then "pressed" else "default"
    if turnedLeft
      @encoderActions[id][encoderStateKey] @, -1
    elseif turnedRight
      @encoderActions[id][encoderStateKey] @, 1
    else
      @encoderState[id] = wasPressed if not turnedLeft and not turnedRight
      encoderStateKey = if @encoderState[id] then "pressed" else "default"
      @encoderActions[id][encoderStateKey](@,0)

  setBrightness: (brightness) =>
    @state.brightness = brightness
    @screenBrightnessState::change(brightness)

  onStateChanged: (key, old, new) =>
    @setBrightness(new) if key == "brightness"

  encoderActions:
    * default: (sign) =>
        @setBrightness clamp0100(@state.brightness + sign*5)
      pressed: (sign) =>
        @screenContrastState::change clamp(@screenContrastState::value! + sign*5, 10, 90)
    * default: (sign) =>
        @logger.i "2d"
      pressed: (sign) =>
        @logger.i "2p"
    * default: (sign) =>
        @logger.i "3d"
      pressed: (sign) =>
        @logger.i "3p"
    * default: (sign) =>
        @logger.i "3d"
      pressed: (sign) =>
        @logger.i "3p"
