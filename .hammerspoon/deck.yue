clamp = (value, min, max) -> math.max(min, math.min(max, value))
clamp0100 = (value) -> clamp(value, 0, 100)

class Deck extends Drive
  icon: "🎛️"
  onNew: =>
    @screenBrightnessState = hs.watchable.watch("Screens", "brightness", (...) -> )
    @screenContrastState = hs.watchable.watch("Screens", "contrast", (...) -> )
    -- TODO move sound/volume to its own Drive
    @remoteVolumeSetter = hs.timer.delayed.new(0.1, -> @remoteSetVolumeNow!)

    -- TODO combine these two
    @persistedStateKeys = { "brightness", "contrast", "volume", "remoteVolume"}
    @initialState = { brightness: 50, contrast: 50, volume: 0, remoteVolume: 0 }

    @device = nil
    @encoderState = [false, false, false, false]

    @drawDefaultScreen = hs.timer.delayed.new(1, -> @drawDefaultScreenNow!) -- TODO macro decorator?

  onStart: =>
    hs.streamdeck.init (connected, deck) -> @onConnect(connected, deck)
    -- TODO populate state

  onConnect: (connected, device) =>
    unless connected
      @logger.i "Disconnected from #{@device}"
      @device = nil
      @stop!
      return false

    @device = device
    @columns, @rows = @device::buttonLayout!
    @buttonSize = hs.geometry @device::imageSize!
    @screenSize = hs.geometry "800x100" -- Not exposed, hard-coded to avoid Obj-C resizing
    @numEncoders = 4
    @screenPieceWidth = @screenSize.w / @numEncoders

    @logger.i "Connected to #{@device}"
    @logger.i "       Layout: #{@rows} rows, #{@columns} columns"
    @logger.i "  Button Size: #{@buttonSize.string} pixels"
    @logger.i "  Screen Size: #{@screenSize.string} pixels"
    @logger.i "     Encoders: #{@numEncoders}"

    @state.brightness = @state.brightness
    @device::encoderCallback (...) -> @onEncoder ...
    @drawDefaultScreen::start!

  onEncoder: (deck, id, wasPressed, turnedLeft, turnedRight) =>
    return unless deck == @device

    encoderStateKey = if @encoderState[id] then "pressed" else "default"

    value = if turnedLeft
      @encoderActions[id][encoderStateKey] @, -1
    elseif turnedRight
      @encoderActions[id][encoderStateKey] @, 1
    else
      @encoderState[id] = wasPressed if not turnedLeft and not turnedRight
      encoderStateKey = if @encoderState[id] then "pressed" else "default"
      @encoderActions[id][encoderStateKey](@,0)
      0

    return true if encoderStateKey[id] == "default" and value == 0 -- Don't draw on release

    returnType = type(value)
    if returnType == "number"
      @drawMeter(value)
      hs.timer.doAfter(1, -> @drawDefaultScreen::start!)
    else
      @logger.w "Action for encoder ##{id} (#{encoderStateKey}) returned a #{type(returnType)}, instead of a number:"
      @logger.w "  #{hs.inspect(value)}"

  onStateChanged: (key, old, new) =>
    @device::setBrightness(clamp(new // 2, 10, 50)) if key == "brightness"
    hs.audiodevice.defaultOutputDevice!::setVolume(clamp0100(new)) if key == "volume"
    @remoteSetVolume! if key == "remoteVolume"

  remoteSetVolume: =>
    @remoteVolumeSetter::start!

  remoteSetVolumeNow: =>
    hs.osascript.applescript  [[
      tell application "Finder" of machine "eppc://bkudria@Basho.local"
        set volume output volume ]]..@state.remoteVolume..[[ --
      end tell
    ]]

    @logger.i "Set remote volume to #{@state.remoteVolume}"

  setBrightness: (brightness) =>
    @state.brightness = brightness
    @screenBrightnessState::change(brightness)
    brightness

  setContrast: (contrast) =>
    @state.contrast = contrast
    @screenContrastState::change(contrast)
    contrast

  drawMeter: (value) => @drawScreenNow @rectLeft(value, @screenSize.table)::imageFromCanvas!
  drawDefaultScreenNow: () => @drawScreenNow @rect(@screenSize.table, {white:0})::imageFromCanvas!

  -- TODO use state instead
  drawScreenNow: (image) =>
    for index = 1, @numEncoders
      @device::setScreenImage index, image::croppedCopy{
        x: (index - 1) * @screenPieceWidth
        y: 0
        w: @screenPieceWidth
        h: @screenSize.h
      }

  encoderActions:
    * default: (sign) =>
        @setBrightness clamp0100(@state.brightness + sign*5) -- TODO these should just be setting state
      pressed: (sign) =>
        @setContrast clamp(@state.contrast + sign*5, 0, 85)
    * default: (sign) =>
        @logger.i "2d"
      pressed: (sign) =>
        @logger.i "2p"
    * default: (sign) =>
        @logger.i "3d"
      pressed: (sign) =>
        @logger.i "3p"
    * default: (sign) =>
        @state.volume = clamp0100(@state.volume + sign*5) -- TODO Abstract simple setState
        @state.volume
      pressed: (sign) =>
        @state.remoteVolume = clamp0100(@state.remoteVolume + sign)
        @state.remoteVolume

  -- TODO should we reuse a canvas?
  -- TODO How many? 1 per button/encoder? or 1/screen?
  -- TODO Benchmark
  rect: (size, color = {white: 1}) =>
    hs.canvas.new{"0 0", ...size}
      ::appendElements{
        type: "rectangle"
        action: "fill"
        fillColor: color
        frame: {x:0, y:0, w:"1.0", h:"1.0"}
      }

  rectLeft: (percent, ...) =>
    @rect(...)::elementAttribute(1,"frame", {x:0, y:0, w:"#{percent}%", h:"1"})
