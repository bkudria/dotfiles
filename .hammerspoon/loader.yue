import "yue" as yue

basename = (str) -> string.gsub(str, "(.*/)(.*)", "%2")
endswith = (ext) -> "^[^#][a-z%-]+%.#{ext}"

class Loader extends Drive
  icon: "♻️"
  onNew: =>
    @watcher = hs.pathwatcher.new("#{os.getenv('HOME')}/.hammerspoon/", (...) -> @watchConfig(...))

  onStart: =>
    @watcher::start!

  watchConfig: (paths) =>
    for path in *paths
      filename = basename path
      continue unless filename\match(endswith("lua")) or filename\match(endswith("yue"))
      continue if filename\match("^%.#.*")

      if filename\match endswith("yue")
        _, syntaxErr = yue.loadfile path
        if syntaxErr
          @logger.e "Syntax error in #{filename}:\n#{syntaxErr}"
          hs.openConsole(true)
          return
        else
          @reload!

  reload: =>
    @logger.i "publishing reload!"
    @state.reloading = true
    hs.timer.doAfter 0.1, hs.reload
