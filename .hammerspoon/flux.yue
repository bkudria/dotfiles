class Flux
  new: =>
    @logger = hs.logger.new("flux", "info")

    debouncedApply = hs.timer.delayed.new(1, ->
      @logger.i("requested apply")
      @apply!
    )

    hs.settings.watchKey("flux", "sunrise", ->
      @logger.i("sunrise changed")
      debouncedApply\start(0.1)
    )

    hs.settings.watchKey("flux", "sunset", ->
      @logger.i("sunset changed")
      debouncedApply\start(0.1)
    )

    hs.settings.watchKey("flux", "mode", ->
      @logger.i("mode changed")
      debouncedApply\start(0.1)
    )

  apply: =>
    @logger.i(hs.inspect({st: @startTime!, et: @endTime!, fg: @finalGamma!, mode: @mode!}))
    @logger.i("Applying redshift: #{@startTime!}-#{@endTime!}, to final gamma #{@finalGamma!} over 4h")
    hs.redshift.start(@finalGamma!, @startTime!, @endTime!, '1h')

  startTime: =>
    if @mode! == "media"
        string.format("%.2d:%.2d", os.date('%H'), os.date('%M'))
    else
        @sunset!

  endTime: =>
    hs.settings.get('sunrise')

  sunset: =>
    hs.settings.get('sunset')

  mode: =>
    hs.settings.get('mode')

  finalGamma: =>
    if @mode! == "media"
      5000
    else
      3000
