class Flux extends Drive
  icon: "🌅"
  onNew: =>
    @debouncedStart = hs.timer.delayed.new(1, ->
        @logger.i("requested apply")
        @onStart!
    )
    @debouncedStart::stop!

    @watchers = [
      hs.settings.watchKey("flux", "sunrise", ->
        @logger.i("sunrise changed")
        @debouncedStart::start(0.1)
      )

      hs.settings.watchKey("flux", "sunset", ->
        @logger.i("sunset changed")
        @debouncedStart::start(0.1)
      )

      hs.settings.watchKey("flux", "mode", ->
        @logger.i("mode changed")
        @debouncedStart::start(0.1)
      )
    ]

  onStart: =>
    @logger.i("Applying redshift: #{@startTime!}-#{@endTime!}, to final gamma #{@finalGamma!} over 1h")
    hs.redshift.start(@finalGamma!, @startTime!, @endTime!, '1h')

  startTime: =>
    if @mode! == "media"
        string.format("%.2d:%.2d", os.date('%H'), os.date('%M'))
    else
        @sunset!

  endTime: =>
    hs.settings.get('sunrise')

  sunset: =>
    hs.settings.get('sunset')

  mode: =>
    hs.settings.get('mode')

  finalGamma: =>
    if @mode! == "media"
      5000
    else
      3000
